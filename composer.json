{
    "name": "kwame-boateng/filament-math-rich-editor",
    "description": "A math rich editor for Filament using Tiptap and KaTeX.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "KwameBoateng\\MathRichEditor\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KwameBoateng\\MathRichEditor\\MathRichEditorServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0",
        "illuminate/contracts": "^11.0|^12.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}